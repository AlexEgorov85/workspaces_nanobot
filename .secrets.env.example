DB_PASSWORD=CHANGE_ME_PASSWORD

# providers: llm — ключ LLM-провайдера агента; используется и навыком (audit_analyzer)
api_key=YOUR_LLM_API_KEY

# EMBED_TOKEN — bearer-токен для эмбеддер-сервиса (Ollama / open-webui /
# LiteLLM / клаудные провайдеры с /api/embed-совместимым API), выставленного
# за reverse proxy с авторизацией. Используется как
# ``Authorization: Bearer <token>`` при запросах к
# ``gateway.vector.embedding.base_url``. Если эмбеддер локальный и без
# авторизации (например, Ollama на :11434) — переменная не нужна, в
# project.json::gateway.vector.embedding поле ``auth_token`` не задаётся.
# Раскомментируйте и подставьте токен, если используется reverse proxy.
# EMBED_TOKEN=YOUR_EMBED_TOKEN
