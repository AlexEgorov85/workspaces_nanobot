# ============================================================================
# ═══ .env — центральный конфиг nanobot ═══
#
# Секции:
#   Ln  1  PostgreSQL   — подключение к БД, таблицы сессий, настройки канала
#   Ln 13  Redis        — опциональный Redis-канал (выключен по умолчанию)
#   Ln 20  Gateway      — шлюз: storage, persist, таймауты, log_level
#   Ln 29  CLI          — агент в CLI-режиме: отображение, таймауты, итерации
#   Ln 41  Skills: audit_analyzer — LLM, схемы БД, embeddings, векторные индексы
#   Ln 72  Skills: data-analyzer  — LLM, анализатор, поддерживаемые расширения
#   Ln 86  Benchmark    — схема и таблицы для бенчмарков
#   Ln 91  Streamlit    — веб-интерфейс: таймауты
# ============================================================================

# PostgreSQL
dsn=postgresql://postgres:1@localhost:5432/postgres
schema=public
messages_table=session_messages
meta_table=session_meta
channel__enabled=true
channel__table=conversation_messages
channel__poll_interval=2.0
channel__flush_interval=2.0
channel__max_concurrent=1
channel__processing_timeout=120

# Redis
enabled=false
host=127.0.0.1
port=6379
incoming_key=nanobot:inbox
outgoing_prefix=nanobot:outbox

# Gateway
storage=auto
persist_threshold=5000
persist_max_files=100
persist_max_age_hours=0
llm_timeout=300
exec_timeout=60
log_level=INFO

# CLI
show_reasoning=true
show_tool_calls=true
show_tool_results=true
show_tool_params=true
show_progress=true
typewriter_speed=0.01
llm_timeout=300
exec_timeout=60
max_iterations=200
log_level=WARNING

# Skills: audit_analyzer
llm_provider=mistral
llm_model=mistral-large-latest
llm_api_base=https://api.mistral.ai/v1
llm_max_tokens=8192
llm_temperature=0.1
db_schema=oarb
db_tables=audit_reports,audits,report_items,violations
schema_cache_enabled=true
schema_cache_path=cache/schema.json
schema_cache_ttl=86400
in_memory_enabled=true
in_memory_engine=duckdb
in_memory_cache_path=cache/audit_cache.duckdb
embedding_base_url=http://localhost:11434/api/embed
embedding_model=mxbai-embed-large:latest
embedding_dimension=1024
mode_predefined_enabled=true
mode_vector_enabled=true
mode_vector_index_path=C:/Users/Алексей/Documents/WORK/Agent_v5/data/vector
mode_vector_top_k=5
mode_vector_threshold=0.75
mode_vector_db_table=oarb.audit_vectors
mode_sql_enabled=true
cli_default_mode=predefined
cli_default_format=json
cli_max_retries=3
cli_timeout_sec=60
vector_indexes={"audits_index":{"table":"oarb.audits","pk":"id","source_table":"audits","content_columns":["title"],"embedding_columns":["title","audit_type","auditee_entity"],"track_column":"updated_at","enabled":true},"violations_index":{"table":"oarb.violations","pk":"id","source_table":"violations","content_columns":["violation_code","description"],"embedding_columns":["violation_code","description","recommendation"],"track_column":"created_at","enabled":true},"audit_reports_index":{"table":"oarb.audit_reports","pk":"id","source_table":"audit_reports","content_columns":["title"],"embedding_columns":["title","full_text"],"track_column":"updated_at","enabled":false},"report_items_index":{"table":"oarb.report_items","pk":"id","source_table":"report_items","content_columns":["item_title"],"embedding_columns":["item_title","item_content"],"track_column":"updated_at","enabled":false}}

# Skills: data-analyzer
llm_provider=ollama
llm_model=glm-4.6:cloud
llm_api_url=http://localhost:11434/api/generate
llm_api_key=
llm_temperature=0.2
llm_max_tokens=4000
llm_context_window=8192
analyzer__chunk_ratio=0.7
analyzer__max_retries=3
analyzer__retry_delay_base=2
supported_structured=.csv,.xlsx,.xls,.json
supported_text=.txt,.log,.md,.py,.js,.json,.csv

# Benchmark
db_schema=public
runs_table=benchmark_runs
results_table=benchmark_results

# Streamlit
max_wait=600
poll_interval=1.0
