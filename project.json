{
  // ============================================================================
  //  project.json — настройки проекта nanobot (дополнение к config.json)
  // ============================================================================
  //  Читается config.py и мержится в SETTINGS в порядке (поздний перекрывает):
  //      project.json → config.json → .secrets.env (секреты)
  //
  //  Формат: JSONC — обычный JSON + комментарии // и /* */.
  //  Значения вида ${VAR} подставляются из os.environ (секреты — из .secrets.env).
  //
  //  Секции (порядок логический, не синтаксический):
  //      project           — метаданные проекта (version и т.п.)
  //      channels.*        — каналы связи (Postgres, Redis, пулы)
  //      skills.*          — настройки пользовательских навыков
  //      cli               — настройки CLI-агента (cli_agent.py)
  //      gateway           — gateway-сервер + перезапуск + subprocess'ы
  //      logging.db        — структурированный журнал (DbLoggingService)
  //
  //  Нативный конфиг nanobot (агенты, провайдеры, API) — в config.json.
  //
  //  Правило добавления новой настройки:
  //    1. Объявить ключ здесь (с дефолтом и комментарием).
  //    2. В коде читать через get_setting(*keys, default=...) или SETTINGS.*.
  //    3. Добавить запись в REQUIRED_KEYS в tests/test_config_keys.py.
  // ============================================================================

  // ---------------------------------------------------------------------------
  //  channels.* — каналы связи
  // ---------------------------------------------------------------------------
  "project": {
    "version": "2.5.2"   // Версия проекта (актуальный релизный тег vX.Y.Z без префикса v)
  },

  "channels": {
    // Общее поведение для всех каналов (Postgres, Redis, будущие).
    // При превышении document_text_threshold в user-промпт кладётся маркер
    // [File: <basename> — text omitted (len=… > threshold=…); read at <path>]
    // вместо полного текста документа (защита от раздува контекста).
    "document_text_threshold": 20000,
    "postgres": {
      "enabled": true,                        // Канал включён. Варианты: true | false
      "dsn": "${DATABASE_URL}",               // Полный DSN. Единственный источник подключения — резолвится из .secrets.env (${DATABASE_URL}). Без fallback на части.
      "schema": "public",                     // Схема БД
      "messages_table": "agent_session_messages",   // Таблица сообщений сессий (PGSessionManager)
      "meta_table": "agent_session_meta",           // Таблица метаданных сессий (PGSessionManager)
      "table_name": "agent_conversation_messages",  // Таблица обмена сообщениями (PostgresChannel)
      "poll_interval": 10.0,                   // Поллинг новых сообщений, сек
      "flush_interval": 5.0,                  // Сброс reasoning в metadata, сек
      "max_concurrent": 2,                    // Макс. параллельно обрабатываемых сообщений
      "processing_timeout": 600,              // Зависшее сообщение → возврат в пул (см. _unstick_processing), сек
      "unstick_interval": 120.0,              // Интервал фонового _unstick_loop (сек).
                                             //   По дефолту max(60, processing_timeout/5) = 120 сек.
                                             //   Уменьшает нагрузку на БД на пустом столе (вместо
                                             //   SELECT+UPDATE каждые poll_interval).
      "max_stuck_retries": 3,                 // Лимит retry зависшего сообщения (postgres_channel.py)
      "msg_ctx_max_size": 100,                // Защитный лимит размера _msg_ctx (postgres_channel.py)
      "worker_id": "",                        // ID инстанса в логах и выводе активности. Пусто → авто: {hostname}:{pid}:{uuid8}
      "error_retry_delay": 60.0,              // Пауза перед повтором задачи со статусом error, сек
                                             //   ВНИМАНИЕ: ветка повтора в _claim_one сейчас недостижима —
                                             //   внешний AND status='pending' отсекает status='error'.
                                             //   Настройка сохранена как контракт _mark_failed, см. CHANGELOG.
      "media_cache_dir": "data_store/cache/sessions",  // Кеш медиа-файлов сессий
      "allow_from": ["*"],                    // Допустимые отправители. Варианты: ["*"] — все | ["<sender_id>", ...] — точное совпадение (nanobot/channels/base.py:203)
      "pool": {                               // Параметры пула psycopg2 (session_storage.py)
        "min_conn": 1,
        "max_conn": 4,
        "pool_timeout": 5.0                    // Порог diagnostic-warning о долгом ожидании транзакции в очереди (не лимит!)
      }
    },
    "redis": {
      "enabled": false,                       // Выключен по умолчанию. Варианты: true | false
      "host": "127.0.0.1",
      "port": 6379,
      "db": 0,
      "password": null,                       // Пароль Redis. Варианты: null (без пароля) | "<пароль>"
      "incoming_key": "nanobot:inbox",        // Список входящих (BRPOP)
      "outgoing_prefix": "nanobot:outbox",    // Префикс очередей ответов (LPUSH outbox:{chat_id})
      "poll_timeout": 5.0,                    // Таймаут BRPOP, сек
      "max_concurrent": 1,                    // Макс. параллельно обрабатываемых сообщений
      "error_backoff_sec": 1.0,               // Пауза между итерациями при исключении BRPOP
      "reply_to_max_size": 10000,             // Защитный потолок размера _reply_to_map
      "reply_to_trim_to": 5000,               // Целевой размер после усечения
      "allow_from": ["*"]                     // Варианты: ["*"] — все | ["<sender_id>", ...] — точное совпадение
    }
  },

  // ---------------------------------------------------------------------------
  //  skills.* — настройки пользовательских навыков (универсальная схема)
  // ---------------------------------------------------------------------------
  //  Каждый skill объявляется одной JSON-секцией со стандартным набором полей
  //  (см. lib/core/project_settings.py::SkillSettings). Никакого register.py
  //  не требуется: ApplicationContext читает эту секцию при старте и
  //  автоматически создаёт TableResource/VectorResource в table_registry.
  //
  //  Чтобы добавить новый skill:
  //    1. Добавить секцию "skills.<name>" с массивом tables (TableResource).
  //    2. Если нужны векторные индексы — добавить vector_indexes.
  //    3. Готово: skill подхватится на старте gateway без правок кода.
  //
  //  Секции (все OPTIONAL):
  //      enabled            — отключить skill без удаления секции (default: true)
  //      tables             — единый список ресурсов skill'а (см. ниже "Структура tables")
  //      vector_indexes     — массив {name}: имена индексов, используемых навыком.
  //                           Source-таблица (PG-таблица исходных строк для
  //                           эмбеддингов) — инфраструктурная декларация в
  //                           public.agent_vector_index_config. backend и путь
  //                           хранения — общая инфраструктура
  //                           (см. gateway.vector.index.*).
  //      cli.*              — параметры CLI навыка (default_mode, default_format, max_retries, timeout_sec)
  //      llm.*              — execution policy для skill'а: max_tokens/temperature
  //                           для LLM-вызовов (генерация SQL, обобщение).
  //                           Выбор модели/провайдера — в config.json (nanobot).
  //
  //  ГРАНИЦА skills.*: только то, что меняется при смене ДОМЕНА skill'а.
  //  Общая runtime-инфраструктура — снаружи:
  //    * embedding service (Ollama /api/embed, включая auth_token) → gateway.vector.embedding
  //    * DuckDB snapshot path                                  → table_registry.snapshot_path()
  //    * FAISS backend / storage / root                        → gateway.vector.index.*
  //    * PG → DuckDB загрузка кэша                          → без секции (разовая загрузка)
  //  Правило описано в TARGET_ARCHITECTURE §skills.* boundary.
  //
  //  Структура tables (lib/core/project_settings.py::TableEntry):
  //      name              — ОБЯЗАТЕЛЬНО. Имя таблицы в формате "schema.table"
  //                          (контракт TableResource.__post_init__).
  //      type              — "table" (по умолчанию) | "vector". Определяет, какой
  //                          Resource создаёт _auto_register_skills: обычный
  //                          TableResource или VectorResource. Попадает ли
  //                          таблица в DuckDB, определяется автоматически
  //                          по VectorResource.
  //      label             — OPTIONAL opaque-метка. Если label задан, таблица
  //                          НЕ попадает в описание схемы для LLM
  //                          (get_db_tables() возвращает только таблицы
  //                          без label); доступ к ней — через
  //                          TableRegistry.resources_by_label(label).
  //                          Типичный кейс: реестры метаданных из других
  //                          схем (например, public.agent_predefined_scripts
  //                          с label="scripts_registry"). Runtime-sync
  //                          игнорирует.
  //      tracking_column   — OPTIONAL колонка для инкрементального поллинга.
  //                          Дефолт "updated_at" для type="table", "id" для
  //                          type="vector".
  //      Элемент может быть строкой "schema.table" (равно {"name": "schema.table"})
  //      или объектом с полями выше. Неизвестные ключи в объекте запрещены
  //      (extra="forbid") — fail-fast на опечатках.
  //
  //  ВНИМАНИЕ: skills.<name> имеет model_config = extra="forbid". Любой
  //  неизвестный ключ в skill-секции вызовет ConfigurationError на старте
  //  gateway (например, опечатка "tablse" или оставшийся от старой версии
  //  ключ "embedding"/"cache"). Это сознательное ужесточение контракта.
  //
  //  Секции gateway.sync.* (поллинг, очередь записов, reconnect-бэкофф)
  //  УДАЛЕНЫ: была фоновой синхронизации. Загрузка кэша —
  //  разовая операция при старте процесса (снимок PG в момент загрузки).
  // ---------------------------------------------------------------------------
  "skills": {
    "audit_analyzer": {
      "enabled": true,

      "tables": [                                    // Доменные таблицы навыка (без инфраструктурных
                                                   // storage-таблиц — они в gateway.vector.index.*).
                                                   // tracking_column по умолчанию updated_at для type=table,
                                                   // задаётся явно только когда отличается.
                                                   // label отмечает реестры метаданных
                                                   // (не попадают в описание схемы для LLM).
        {"name": "oarb.audit_reports"},
        {"name": "oarb.audits"},
        {"name": "oarb.report_items"},
        {"name": "oarb.violations"},
        {"name": "public.agent_predefined_scripts", "label": "scripts_registry"}
      ],

      "vector_indexes": [                            // Имена индексов, используемых навыком.
                                                   //   name — логическое имя индекса (как его
                                                   //          видит tool vector_search и
                                                   //          <default_root>/<name> даёт путь к FAISS).
                                                   //   source-таблица (PG-таблица исходных строк)
                                                   //   хранится в public.agent_vector_index_config
                                                   //   (runtime-БД, инфраструктурная декларация).
        {
          "name": "audits_index"
        },
        {
          "name": "violations_index"
        },
        {
          "name": "audit_reports_index"
        }
      ]
      // После перевода навыка на tool-only (skill использует только
      // duckdb_query / vector_search, никакого CLI) секции cli.* и
      // llm.* не нужны:
      //   * cli.* — был для scripts/cli.py (удалён);
      //   * llm.* — LLM-параметры берутся из общего резолва
      //     lib.services.llm_config.resolve_llm_config (модель/провайдер
      //     из agents.defaults, ключи из providers.*).
    },

    // -------------------------------------------------------------------------
    //  legal_summarizer — суммаризация юридических документов (PDF/DOCX/TXT).
    //  Извлечение текста — workspace.utils.office_files.extract_text;
    //  чанкинг — lib.services.text_splitter.split_text;
    //  LLM-клиент — lib.services.llm_client.call_llm.
    //  У skill'а нет PG-таблиц, поэтому tables[] пуст и регистрация в
    //  TableRegistry пропускается автоматически.
    // -------------------------------------------------------------------------
    "legal_summarizer": {
      "enabled": true,

      "cli": {                                       // legal_summarize --length ...
        "default_length": "brief",                   // brief | detailed (medium удалён в Phase 2B+)
        "timeout_sec": 120,
        "max_retries": 3
      },

      "llm": {                                       // Execution policy для саммари.
        "max_tokens": 8192,
        "temperature": 0.1
      },

      "chunking": {                                  // Map-reduce пороги для длинных документов.
                                                   // Источник истины для размера чанка —
                                                   // chunk_size_input_ratio (доля от контекстного окна):
                                                   // chunk_size = contextWindowTokens * chunk_size_input_ratio
                                                   // Остальные поля (chunk_size/chunk_overlap) — fallback,
                                                   // если ratio не задан или контекстное окно неизвестно.
        "chunk_size_input_ratio": 0.5,              // Доля контекстного окна под один чанк (0 < r < 1).
                                                   // 0.5 - компромисс между числом LLM-вызовов и риском
                                                   // переполнения контекста (system prompt + history + ответ).
                                                   // Для контекста 65536 tokens * 0.5 ~ 100K символов
                                                   // (русский текст ~3.5 chars/token) - ГК РФ за ~20 чанков.
        "chunk_size": 100000,                        // Fallback если ratio не задан/не применим.
        "chunk_overlap": 0,                          // Этап 11: overlap=0 для summarization.
                                                    // В RAG overlap нужен для recall, но summarization
                                                    // обрабатывает каждый chunk независимо → overlap
                                                    // только раздувает LLM-вход без пользы.
                                                    // Oversized blocks (этап 10) получают минимальный
                                                    // overlap внутри split_text fallback для continuity.
        "single_call_threshold": 20000,              // Ниже этого — single-call, выше — map-reduce.

        //  brief_input_ratio — доля контекстного окна под ОДИН итоговый
        //  brief-chunk (вместо выборки canonical chunks). Контракт:
        //    max_chars = contextWindowTokens * brief_input_ratio * chars_per_token.
        //  Источник contextWindowTokens — agents.defaults.contextWindowTokens
        //  в config.json. Если ключ недоступен — fallback на max_chars ниже.
        //  Подробности: workspace/skills/legal_summarizer/scripts/application/brief_context.py.
        "brief_input_ratio": 0.13
      },

      //  brief_context.* — параметры BriefContextBuilder (этап brief-refactor):
      //  brief теперь собирает ровно один Chunk из DocumentStructure +
      //  PhysicalDocument (а не выборку canonical chunks). Эти параметры
      //  описывают приоритеты составных частей итогового chunk'а
      //  (структура → preamble → top-level sections).
      //  Подробности: workspace/skills/legal_summarizer/scripts/application/brief_context.py.
      "brief_context": {
        "max_chars_fallback": 30000,        // Fallback если контекстное окно неизвестно
                                            // (contextWindowTokens отсутствует в config.json).
                                            // В норме max_chars расчитывается динамически:
                                            //   max_chars = agents.defaults.contextWindowTokens
                                            //             * chunking.brief_input_ratio
                                            //             * brief_context.chars_per_token
        "chars_per_token": 3.5,             // Оценка токенов для русского текста (используется
                                            // для Chunk.token_estimate).
        "structure_max_chars": 12000       // Лимит на блок DOCUMENT STRUCTURE. Если структура
                                            // документа превышает этот порог, outline обрезается
                                            // по newline-boundary, чтобы оставить budget контенту.
      },

      "execution": {                                 // Phase 2B: пользовательский контроль
                                                   // над долгими операциями + safety net + context batching.
        "confirmation_threshold_sec": 120,           // Если estimated_duration_max_sec > этого
                                                   // значения, skill возвращает confirmation_required
                                                   // и ждёт --confirm. Дефолт: 2 минуты.
        "estimated_chunk_duration_sec": 20,          // Оценка времени обработки одного ContextBatch
                                                   // (Phase 2B: считается per-batch, а не per-chunk).
        "max_chunks_for_execution": 50,              // Safety net: chunks_total > этого значения → requires_continuation.
        "max_concurrent_batches": 1,                 // DEPRECATED: runtime invariant single-flight (см. ARCHITECTURE.md §21).
                                                      // Ключ оставлен для backward-compat, runtime всегда clamp'ит до 1.
                                                      // Значения > 1 эмитят DeprecationWarning и игнорируются.
                                                      // Удаление ключа планируется в v3.0 (MAJOR).
"max_chunks_per_question": 10,               // Лимит выборки для brief и --question режимов.
                                                      // brief: ≤10 И ≤50% от chunks_total, round-robin по секциям.
                                                      // question: ≤N релевантных chunks.
        "context_batching": {                        // Phase 2B: параметры TokenBudget.
          "chars_per_token": 3.5,                    // Оценка токенов для русского текста.
          "system_prompt_tokens": 1200,              // Резерв под system prompt + format(length_instruction).
          "instruction_tokens_per_map": 200,         // Резерв под инструкции в user_body.
          "safety_margin": 0.85,                     // 15% запас поверх budget.
          "llm_max_tokens": 8192                    // Резерв под output.
        }
      }
    }
  },

  // ---------------------------------------------------------------------------
  //  cli.* — настройки CLI-агента (cli_agent.py)
  // ---------------------------------------------------------------------------
  "cli": {
    "show_reasoning": true,       // Показывать рассуждения агента
    "show_tool_calls": true,      // Показывать вызовы инструментов
    "show_tool_results": true,    // Показывать результаты инструментов
    "show_tool_params": true,     // Показывать параметры вызовов
    "show_progress": true,        // Прогресс обработки
    "show_context_window": true,  // Печатать занятость контекстного окна (M1 UI в console_loop.py)
    "typewriter_speed": 0.01,     // Скорость "печатания" ответа, сек/символ
    "llm_timeout": 300,           // Таймаут LLM-запроса, сек
    "exec_timeout": 60,           // Таймаут exec-инструмента, сек
    "max_iterations": 200,        // Макс. итераций агента
    "log_level": "WARNING",       // Уровень логирования. Варианты: DEBUG | INFO | WARNING | ERROR
    "repl_idle_timeout_sec": 1.0  // Таймаут REPL-цикла ожидания outbound (console_loop.py)
  },

  // ---------------------------------------------------------------------------
  //  gateway.* — настройки gateway-сервера (gateway.py)
  // ---------------------------------------------------------------------------
  "gateway": {
    "storage": "file",                // Хранилище сессий. Варианты: auto | postgres | file
    //   auto     — PGSessionManager при наличии dsn, иначе JSONL-файлы
    //   postgres — только PGSessionManager (без dsn — ошибка)
    //   file     — только JSONL-файлы (SessionManager), dsn игнорируется
    "persist_threshold": 50000,       // Порог байт для выноса результата в файл
    "persist_max_files": 100,         // Макс. файлов в data_store/cache/sessions/
    "persist_max_age_hours": 0,       // 0 = хранить бессрочно
    //  tool_result_limits.* — потолки вывода инструментов (runtime_patcher.py).
    //  Все ключи опциональны; дефолты ниже совпадают с теми, что уже в коде.
    "tool_result_limits": {
      "exec_max_output_chars": 500000,      // Потолок вывода exec/shell (MAX_OUTPUT_CHARS)
      "exec_default_output_chars": 100000,  // Дефолт разового exec (ExecTool._MAX_OUTPUT)
      "read_file_max_chars": 512000,        // ReadFileTool._MAX_CHARS (маркер truncated)
      "grep_head_limit": 500,               // search._DEFAULT_HEAD_LIMIT
      "grep_file_head_limit": 400,          // search._DEFAULT_FILE_HEAD_LIMIT
      "grep_max_file_bytes": 20000000,      // GrepTool._MAX_FILE_BYTES
      "list_dir_max_entries": 500           // ListDirTool._DEFAULT_MAX (marker truncated)
    },
    "llm_timeout": 300,               // Таймаут LLM, сек
    "exec_timeout": 0,                // Таймаут exec, сек. 0 = без лимита (сессия живёт, пока процесс не завершится). Важно для долгих навыков вроде legal_summarizer: дефолт 60 убивал прогон ровно на 60-й секунде, до печати финального sentinel. Per-call таймаут агента всё равно ограничен _MAX_TIMEOUT=600s в nanobot — поэтому агент должен НЕ передавать timeout (или передавать 0), иначе прогон >600с будет убит.
    "exec_timeout_cap_sec": 3600,      // Потолок явного per-call timeout exec (поднимается RuntimePatcher.patch_exec_timeout_cap). Ниже 600 nanobot не даст; 3600 покрывает прогоны до 1 часа даже если агент передаст явный timeout.
    "log_level": "INFO",              // Уровень логирования. Варианты: DEBUG | INFO | WARNING | ERROR
    "print_llm_calls": true,          // Выводить в терминал токены LLM-итераций (→ промпт / ← ответ). Варианты: true | false
    "print_worker_activity": false,    // Выводить в терминал активность пула воркеров [task-worker]/[очередь-задач]: взял/закончил задачу, размер очереди. Варианты: true | false
    "print_db_activity": false,        // Выводить в терминал активность воркеров соединений БД [db-worker]/[очередь-БД]: взял/закончил job. Варианты: true | false
    "print_tools": false,              // Выводить в терминал результат каждого tool-call (TerminalToolPrintHook). false — гасит шум от долгих write_stdin/exec; ошибки тулов всё равно уходят в agent_gateway_logs.
    "restart_initial_delay_sec": 1.0, // Начальная пауза backoff при перезапуске (gateway_runner.py)
    "restart_max_delay_sec": 30.0,    // Потолок backoff при перезапуске
    //  compact.* — ручное сжатие контекста сессии (ContextCompactionService).
    //  Подробности: lib/services/context_compaction.py, workspace/tools/compact_context.py.
    //  Все ключи опциональны; дефолты указаны в коде.
    "compact": {
      "enabled": true,                 // Зарегистрировать tool compact_context и обрабатывать /compact в CLI
      "notify_in_history": true,       // Писать заметку о сжатии в agent_conversation_messages
      "print_to_terminal": false       // Дублировать заметку в терминал gateway (по образцу print_worker_activity)
    },
    //  usage_store.* — параметры upstream LLMUsageStore (metadata-only LLM usage).
    //  Дефолтный путь — <get_runtime_subdir("usage")>/usage.db.
    //  enabled=false отключает observer (graceful degradation).
    "usage_store": {
      "enabled": true
    },
    // === Repeat guard ===
    //  Защитник от вырожденных циклов одинаковых tool-вызовов
    //  (lib/hooks/repeat_guard_hook.py). Секция полностью опциональна:
    //  без неё хук работает в mode="off" и не делает ничего.
    //
    //  "repeat_guard": {
    //    "mode": "off",                    // off | warn | block
    //    "window_size": 20,                // размер скользящего окна вызовов
    //    "max_repeats_in_window": 3,       // столько одинаковых вызовов = повтор
    //    "exempt_tools": []                // ТОЧНЫЕ имена инструментов, без * и ?
    //  },
    //
    //  mode=block поднимает RepeatGuardBlocked, которую перехватывает
    //  патч repeat_guard_block (runtime_patcher.py) и превращает в обычный
    //  синтетический tool-результат — оборот при этом не падает.
    //  Подробности: openspec/specs/runtime/anti-loop/spec.md
    // === /Repeat guard ===
    //  session_cold_sync.* — фоновый mirror upstream JSONL → PG.
    //  enabled=false отключает sync (escape hatch для multi-instance).
    "session_cold_sync": {
      "enabled": true,
      "sync_interval_sec": 30.0,
      "batch_size": 50,
      "stale_tolerance_seconds": 120,
      "sync_lag_threshold_seconds": 3600
    },
    //  error_messages.* — заготовленные ответы при internal-ошибке
    //  AgentLoop._process_message (см. openspec/specs/runtime/error-fallback).
    //    internal_error  — текст, который видит пользователь вместо
    //                      upstream-литерала "Sorry, I encountered an error."
    //                      По умолчанию: "Произошла внутренняя ошибка.
    //                      Попробуйте позже." Детали исключения в content
    //                      НЕ попадают (только в agent_gateway_logs).
    //    log_to_db       — писать ли event_type="turn_failed" в
    //                      agent_gateway_logs через DbLoggingService
    //                      (для history_search и диагностики).
    //                      По умолчанию true.
    //  Ключи опциональны; дефолты — в ErrorMessagesSettings
    //  (lib/core/project_settings.py) и _DEFAULT_INTERNAL_ERROR_TEXT в
    //  lib/services/runtime_patcher.py.
    // "error_messages": {
    //   "internal_error": "Я не справился с вашим вопросом. Попробуйте, пожалуйста, переформулировать конкретнее — например, уточните ключевую часть или приведите пример.",
    //   "log_to_db": true
    // },
    //  vector.* — общая runtime-инфраструктура эмбеддингов и индексов.
    //    Какие индексы строить и из каких source-таблиц — описывается
    //    в index.indexes (см. ниже). PG-реестр public.agent_vector_index_config
    //    больше НЕ читается кодом (SQL-артефакты остались как legacy).
    //    Параметры подключения к эмбеддеру (base_url=Ollama /api/embed,
    //    model=mxbai-embed-large:latest, dimension=1024, timeout=60с)
    //    захардкожены константами в cache_provider_impl.get_embedding();
    //    bearer-токен для reverse-proxy — переменная окружения OS
    //    EMBED_TOKEN=... (в .secrets.env). Прямые значения в project.json
    //    не нужны.
    //    index.*    — FAISS-инфраструктура:
    //      storage_table  — единая PG-таблица-хранилище сырых эмбеддингов
    //                       (формат "schema.table"); регистрируется в
    //                       TableRegistry через register_infra.
    //      default_root   — DEPRECATED: корневая папка FAISS-индексов
    //                       (больше не используется; FAISS собирается в
    //                       памяти из DuckDB-снапшота storage_table).
    //      backend        — runtime-бэкенд построения индексов ("faiss" и т.п.).
    //      indexes        — {имя: VectorIndexConfig}: единственный источник
    //                       конфига индексов (table, pk, content/embedding
    //                       колонки, chunk-параметры, metric, enabled).
    //                       Перенесено из PG-реестра agent_vector_index_config.
    //      signature_table— УДАЛЁН (change remove-vector-index-store):
    //                       persisted FAISS-кеш больше не существует.
    //                       FAISS-индекс собирается из DuckDB-снапшота
    //                       storage_table на лету (preload_indexes при старте).
    //    Ключи опциональны; дефолты — в VectorIndexSettings/VectorIndexConfig.
    //
    //  УСТАРЕВШИЙ ПУТЬ: gateway.vector_index.*  → УДАЛЁН. Используйте
    //  gateway.vector.index.* (это ЕДИНСТВЕННЫЙ канонический путь).
    "vector": {
      "index": {
        "enable": true,
        "storage_table": "oarb.audit_vectors",
        "default_root": "data_store/vectors",
        "backend": "faiss",
        "indexes": {
          "audits_index": {
            "table": "oarb.audits",
            "pk": "id",
            "source_table": "audits",
            "content_columns": ["title", "audit_type", "auditee_entity", "status"],
            "embedding_columns": ["title", "audit_type", "auditee_entity", "status"],
            "track_column": "updated_at",
            "chunk_size": 500,
            "chunk_overlap": 80,
            "metric": "cosine",
            "enabled": true
          },
          "violations_index": {
            "table": "oarb.violations",
            "pk": "id",
            "source_table": "violations",
            "content_columns": ["description", "recommendation", "violation_code", "severity"],
            "embedding_columns": [
              {"column": "description", "chunk": true, "chunk_size": 500, "chunk_overlap": 80},
              "violation_code"
            ],
            "track_column": "updated_at",
            "chunk_size": 500,
            "chunk_overlap": 80,
            "metric": "cosine",
            "enabled": true
          },
          "audit_reports_index": {
            "table": "oarb.audit_reports",
            "pk": "id",
            "source_table": "audit_reports",
            "content_columns": ["full_text", "title", "report_number", "report_date"],
            "embedding_columns": [
              {"column": "full_text", "chunk": true, "chunk_size": 500, "chunk_overlap": 80},
              "title"
            ],
            "track_column": "updated_at",
            "chunk_size": 500,
            "chunk_overlap": 80,
            "metric": "cosine",
            "enabled": true
          }
        }
      }
    }
  },

  // ---------------------------------------------------------------------------
  //  logging.* — структурированный журнал событий агента (DbLoggingService)
  // ---------------------------------------------------------------------------
  "logging": {
    "db": {
      "enabled": true,                 // Варианты: true | false
      "table_name": "agent_gateway_logs",    // Таблица событий агента
      "question_runs_table": "agent_question_runs",  // Контекст вопросов
      "schema": "public",              // Схема
      "flush_interval_sec": 5.0,       // Интервал флаша батча, сек
      "batch_size": 100,               // Размер батча
      "queue_maxsize": 10000,          // Макс. размер очереди
      "min_level": "INFO",             // Варианты: DEBUG | INFO | WARN | ERROR
      "dialect": "postgres",           // Диалект БД. Варианты: postgres | greenplum
      "connect_backoff_sec": 1.0,      // Начальный backoff psycopg2.connect
      "connect_backoff_max_sec": 60.0, // Потолок backoff psycopg2.connect
      "summary_max_chars": 200         // Усечение summary до N символов
    }
  },

  // ---------------------------------------------------------------------------
  //  enterprise_mcp.* — подключение агента к MCP-серверу платформы
  //
  //  Объявление одно: его читает клиент агента (lib/services/
  //  enterprise_mcp_client.py). В config.json секция tools.mcpServers
  //  намеренно пуста — вторая копия процесса означала бы второго
  //  владельца пула PostgreSQL, а владелец у разделяемого ресурса один.
  //
  //  ${NANOBOT_PYTHON} и ${NANOBOT_PROJECT_ROOT} подставляются из
  //  os.environ (config._export_runtime_env): в конфиге нет ни одного
  //  пути конкретной машины. Сервер получает DATABASE_URL из окружения
  //  агента — отдельно он его не знает и без него не поднимается.
  // ---------------------------------------------------------------------------
  "enterprise_mcp": {
    "enabled": true,                             // Варианты: true | false
    "command": "${NANOBOT_PYTHON}",               // Интерпретатор с зависимостями сервера
    "args": ["-m", "servers.enterprise.server"], // Точка входа: stdio-сервер
    "cwd": "${NANOBOT_PROJECT_ROOT}/mcp-platform",
    "tool_timeout_sec": 30.0                     // Таймаут одного вызова операции, сек
  }
}
