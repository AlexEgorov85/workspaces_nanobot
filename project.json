{
  // ============================================================================
  //  project.json — настройки проекта nanobot (дополнение к config.json)
  // ============================================================================
  //  Читается config.py и мержится в SETTINGS в порядке (поздний перекрывает):
  //      project.json → config.json → .secrets.env (секреты)
  //  .env был удалён (миграция в project.json/config.json); код оставил лишь
  //  защитный fallback: если файл .env когда-либо появится, он прочитается первым.
  //
  //  Формат: JSONC — обычный JSON + комментарии // и /* */.
  //  Значения вида ${VAR} подставляются из os.environ (секреты — из .secrets.env).
  //
  //  Секции (порядок логический, не синтаксический):
  //      channels.*        — каналы связи (Postgres, Redis, пулы)
  //      skills.*          — настройки пользовательских навыков
  //      cli               — настройки CLI-агента (cli_agent.py)
  //      benchmark         — сохранение результатов бенчмарков
  //      streamlit         — веб-чат (streamlit_app.py)
  //      gateway           — gateway-сервер + перезапуск + subprocess'ы
  //      logging.db        — структурированный журнал (DbLoggingService)
  //
  //  Нативный конфиг nanobot (агенты, провайдеры, API) — в config.json.
  //
  //  Правило добавления новой настройки:
  //    1. Объявить ключ здесь (с дефолтом и комментарием).
  //    2. В коде читать через get_setting(*keys, default=...) или SETTINGS.*.
  //    3. Добавить запись в REQUIRED_KEYS в tests/test_config_keys.py.
  // ============================================================================

  // ---------------------------------------------------------------------------
  //  channels.* — каналы связи (заменяют секции [PostgreSQL]/[Redis] из .env)
  // ---------------------------------------------------------------------------
  "channels": {
    "postgres": {
      "enabled": true,                        // Канал включён. Варианты: true | false
      "dsn": null,                            // Полный DSN (override). Приоритет над частями ниже. Варианты: null | "postgresql://..."
      "host": "localhost",                    // Хост PostgreSQL/Greenplum
      "port": 5432,                           // Порт
      "dbname": "nanobot",                    // Имя БД
      "user": "postgres",                     // Пользователь
      "schema": "public",                     // Схема БД
      "messages_table": "agent_session_messages",   // Таблица сообщений сессий (PGSessionManager)
      "meta_table": "agent_session_meta",           // Таблица метаданных сессий (PGSessionManager)
      "table_name": "agent_conversation_messages",  // Таблица обмена сообщениями (PostgresChannel/streamlit)
      "poll_interval": 2.0,                   // Поллинг новых сообщений, сек
      "flush_interval": 2.0,                  // Сброс reasoning в metadata, сек
      "max_concurrent": 1,                    // Макс. параллельно обрабатываемых сообщений
      "processing_timeout": 120,              // Зависшее сообщение → retry (до 3 раз), сек
      "max_stuck_retries": 3,                 // Лимит retry зависшего сообщения (postgres_channel.py)
      "msg_ctx_max_size": 100,                // Защитный лимит размера _msg_ctx (postgres_channel.py)
      "media_cache_dir": "data_store/cache/sessions",  // Кеш медиа-файлов сессий
      "allow_from": ["*"],                    // Допустимые отправители. Варианты: ["*"] — все | ["<sender_id>", ...] — точное совпадение (nanobot/channels/base.py:203)
      "pool": {                               // Параметры пула psycopg2 (session_storage.py)
        "min_conn": 1,
        "max_conn": 4,
        "pool_timeout": 5.0
      }
    },
    "redis": {
      "enabled": false,                       // Выключен по умолчанию. Варианты: true | false
      "host": "127.0.0.1",
      "port": 6379,
      "db": 0,
      "password": null,                       // Пароль Redis. Варианты: null (без пароля) | "<пароль>"
      "incoming_key": "nanobot:inbox",        // Список входящих (BRPOP)
      "outgoing_prefix": "nanobot:outbox",    // Префикс очередей ответов (LPUSH outbox:{chat_id})
      "poll_timeout": 5.0,                    // Таймаут BRPOP, сек
      "max_concurrent": 1,                    // Макс. параллельно обрабатываемых сообщений
      "error_backoff_sec": 1.0,               // Пауза между итерациями при исключении BRPOP
      "reply_to_max_size": 10000,             // Защитный потолок размера _reply_to_map
      "reply_to_trim_to": 5000,               // Целевой размер после усечения
      "allow_from": ["*"]                     // Варианты: ["*"] — все | ["<sender_id>", ...] — точное совпадение
    }
  },

  // ---------------------------------------------------------------------------
  //  skills.* — настройки пользовательских навыков
  // ---------------------------------------------------------------------------
  "skills": {
    "audit_analyzer": {
      // --- LLM: генерация SQL и обобщение результатов -----------------------
      // Навык использует ТУ ЖЕ LLM, что и агент: провайдер/модель/api_base/ключ
      // берутся из agents.defaults + providers.<provider> (config.json).
      // Специфичные для навыка переопределения (llm_provider/llm_model/llm_api_base)
      // задаются только при необходимости отклониться от агентской LLM.
      "llm_max_tokens": 8192,
      "llm_temperature": 0.1,

      // --- База данных: источник данных для анализа ------------------------
      "db_schema": "oarb",                    // Схема с таблицами аудита
      "db_tables": [                          // Таблицы, доступные агенту
        "audit_reports",
        "audits",
        "report_items",
        "violations"
      ],
      "db_additional_tables": [               // Доп. таблицы (из других схем) для копирования в DuckDB-кэш
        ["public", "agent_predefined_scripts"]     // реестр SQL-скриптов (см. predefined_scripts_table)
      ],
      "predefined_scripts_table": "public.agent_predefined_scripts",  // Реестр SQL-скриптов (sql_template + parameters)
      //   Источник истины для режима predefined. Заполняется через
      //   sql/audit_analyzer/create_predefined_scripts_table.sql и
      //   tools/generate_predefined_scripts_sql.py.
      "mode_vector_index_config_table": "public.agent_vector_index_config",  // Конфиг FAISS-индексов (читается cache_provider_impl)

      // --- Фоновая синхронизация (gateway: AuditSyncService) ------------------
      "poll_interval_sec": 60,                // Поллинг новых/изменённых строк из PostgreSQL, сек
      "full_resync_every": 10,                // Полная перезагрузка таблицы каждые N циклов (сверка удалений; 0 = выкл)
      "sync_write_table": "audit_interactions",  // Таблица записи ответов навыка в PG (создаётся автоматически)
      "sync_max_queue_size": 10000,           // Макс. размер очереди синхронизации (audit_sync_service.py)
      "reconnect_backoff_sec": 1.0,           // Начальный backoff после разрыва соединения
      "reconnect_backoff_max_sec": 60.0,      // Потолок reconnect-backoff (экспоненциально)

      // --- In-memory кеш (DuckDB): локальная копия данных для скорости ------
      "in_memory_enabled": true,              // Варианты: true | false
      "in_memory_engine": "duckdb",           // Движок in-memory кеша. Варианты: duckdb (единственный реализованный)
      "in_memory_cache_path": "cache/audit_cache.duckdb",
      "cache_max_age_sec": 3600,              // Возраст кеша для initial-проверки (preload_service.py)
      "cache_refresh_interval_sec": 3600,     // Фоновый интервал проверки кеша

      // --- Эмбеддинги для семантического (векторного) поиска ----------------
      "embedding_base_url": "http://localhost:11434/api/embed",  // Ollama /api/embed
      "embedding_model": "mxbai-embed-large:latest",
      "embedding_dimension": 1024,            // Размерность векторов. Используется read_embedding_config() в cache_provider_impl.py
      "embedding_http_timeout_sec": 60,       // HTTP-таймаут Ollama /api/embed

      // --- Векторный поиск: ИНДЕКСЫ В БАЗЕ ДАННЫХ ----------------------------
      // Векторы и их конфигурация хранятся в PostgreSQL/Greenplum:
      "mode_vector_db_table": "oarb.audit_vectors",  // Таблица сырых векторов (источник индекса)
      "mode_vector_store_table": "public.agent_vector_index_store",  // Таблица FAISS-индексов (BYTEA)
      "vector_index_default_path": "data_store/vectors/audits_index",  // Fallback-путь FAISS-индекса
      // Параметры поиска top_k / threshold задаются аргументами CLI:
      //   audit_analyze --mode vector --query '...' --index-name audits_index --top-k 5 --threshold 0.75 (0.0–1.0)
      // (в конфиге не хранятся — код их не читает)

      // --- Текст-сплиттер (build_vectors.py, text_splitter.py) --------------
      "text_chunk_size": 500,                 // Размер чанка текста для эмбеддинга
      "text_chunk_overlap": 80,               // Перекрытие между чанками
      "build_batch_pause_sec": 0.5,           // Пауза между батчами в build_vectors.py

      // --- Режимы работы навыка ---------------------------------------------
      //   predefined — готовые SQL-шаблоны (--script), кеш в DuckDB
      //   sql        — генерация SQL через LLM по текстовому запросу (--query)
      //   vector     — семантический поиск по индексу из БД (--query + --index-name)
      //   init       — загрузка DuckDB-кеша из PostgreSQL
      "cli_default_mode": "predefined",       // Режим по умолчанию. Варианты: predefined | sql | vector | init (см. выше).
      //   Используется cli.py как default для --mode (если флаг не передан).
      "cli_default_format": "json",           // Формат вывода по умолчанию
      "cli_max_retries": 3,                   // Ретраи LLM при генерации SQL
      "cli_timeout_sec": 60                   // Таймаут запроса к LLM, сек
    }
  },

  // ---------------------------------------------------------------------------
  //  cli.* — настройки CLI-агента (cli_agent.py)
  // ---------------------------------------------------------------------------
  "cli": {
    "show_reasoning": true,       // Показывать рассуждения агента
    "show_tool_calls": true,      // Показывать вызовы инструментов
    "show_tool_results": true,    // Показывать результаты инструментов
    "show_tool_params": true,     // Показывать параметры вызовов
    "show_progress": true,        // Прогресс обработки
    "typewriter_speed": 0.01,     // Скорость "печатания" ответа, сек/символ
    "llm_timeout": 300,           // Таймаут LLM-запроса, сек
    "exec_timeout": 60,           // Таймаут exec-инструмента, сек
    "max_iterations": 200,        // Макс. итераций агента
    "log_level": "WARNING",       // Уровень логирования. Варианты: DEBUG | INFO | WARNING | ERROR
    "repl_idle_timeout_sec": 1.0  // Таймаут REPL-цикла ожидания outbound (console_loop.py)
  },

  // ---------------------------------------------------------------------------
  //  benchmark.* — сохранение результатов бенчмарков в PostgreSQL
  // ---------------------------------------------------------------------------
  "benchmark": {
    "db_schema": "public",            // Схема БД
    "runs_table": "agent_benchmark_runs",   // Таблица прогонов
    "results_table": "agent_benchmark_results"  // Таблица результатов
  },

  // ---------------------------------------------------------------------------
  //  streamlit.* — веб-чат (streamlit_app.py)
  // ---------------------------------------------------------------------------
  "streamlit": {
    "max_wait": 600,                  // Макс. ожидание ответа агента, сек
    "poll_interval": 1.0,             // Интервал поллинга статуса, сек
    "files_dir": "data_store/streamlit_files",  // Папка загруженных файлов
    "failed_window_sec": 300          // Окно retry для failed-сообщений (5 мин)
  },

  // ---------------------------------------------------------------------------
  //  gateway.* — настройки gateway-сервера (gateway.py)
  // ---------------------------------------------------------------------------
  "gateway": {
    "storage": "auto",                // Хранилище сессий. Варианты: auto | postgres | file
    //   auto     — PGSessionManager при наличии dsn, иначе JSONL-файлы
    //   postgres — только PGSessionManager (без dsn — ошибка)
    //   file     — только JSONL-файлы (SessionManager), dsn игнорируется
    "persist_threshold": 5000,        // Порог байт для выноса результата в файл
    "persist_max_files": 100,         // Макс. файлов в data_store/cache/sessions/
    "persist_max_age_hours": 0,       // 0 = хранить бессрочно
    "llm_timeout": 300,               // Таймаут LLM, сек
    "exec_timeout": 60,               // Таймаут exec, сек
    "log_level": "INFO",              // Уровень логирования. Варианты: DEBUG | INFO | WARNING | ERROR
    "restart_initial_delay_sec": 1.0, // Начальная пауза backoff при перезапуске (gateway_runner.py)
    "restart_max_delay_sec": 30.0,    // Потолок backoff при перезапуске
    "streamlit_port": 8501,           // Порт Streamlit subprocess (subprocess_manager.py)
    "streamlit_log_filename": "streamlit.log",  // Имя лог-файла Streamlit
    "subprocess_shutdown_timeout_sec": 5.0  // Таймаут graceful shutdown subprocess'а
  },

  // ---------------------------------------------------------------------------
  //  logging.* — структурированный журнал событий агента (DbLoggingService)
  // ---------------------------------------------------------------------------
  "logging": {
    "db": {
      "enabled": true,                 // Варианты: true | false
      "table_name": "agent_gateway_logs",    // Таблица событий агента
      "question_runs_table": "agent_question_runs",  // Контекст вопросов
      "schema": "public",              // Схема
      "flush_interval_sec": 5.0,       // Интервал флаша батча, сек
      "batch_size": 100,               // Размер батча
      "queue_maxsize": 10000,          // Макс. размер очереди
      "min_level": "INFO",             // Варианты: DEBUG | INFO | WARN | ERROR
      "dialect": "postgres",           // Диалект БД. Варианты: postgres | greenplum
      "fallback_path": "logs/agent_gateway_logs_fallback.jsonl",  // Путь к JSONL-fallback
      "connect_backoff_sec": 1.0,      // Начальный backoff psycopg2.connect
      "connect_backoff_max_sec": 60.0, // Потолок backoff psycopg2.connect
      "summary_max_chars": 200         // Усечение summary до N символов
    }
  }
}
