{
  "channels": {
    "postgres": {
      "enabled": true,
      "dsn": "${DATABASE_URL}",
      "schema": "public",
      "messages_table": "session_messages",
      "meta_table": "session_meta",
      "table_name": "conversation_messages",
      "poll_interval": 2.0,
      "flush_interval": 2.0,
      "max_concurrent": 1,
      "processing_timeout": 120,
      "allow_from": ["*"]
    },
    "redis": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 6379,
      "db": 0,
      "password": null,
      "incoming_key": "nanobot:inbox",
      "outgoing_prefix": "nanobot:outbox",
      "poll_timeout": 5.0,
      "max_concurrent": 1,
      "allow_from": ["*"]
    }
  },
  "skills": {
    "audit_analyzer": {
      "llm_provider": "mistral",
      "llm_model": "mistral-large-latest",
      "llm_api_base": "https://api.mistral.ai/v1",
      "llm_max_tokens": 8192,
      "llm_temperature": 0.1,
      "db_schema": "oarb",
      "db_tables": [
        "audit_reports",
        "audits",
        "report_items",
        "violations"
      ],
      "schema_cache_enabled": true,
      "schema_cache_path": "cache/schema.json",
      "schema_cache_ttl": 86400,
      "in_memory_enabled": true,
      "in_memory_engine": "duckdb",
      "in_memory_cache_path": "cache/audit_cache.duckdb",
      "embedding_base_url": "http://localhost:11434/api/embed",
      "embedding_model": "mxbai-embed-large:latest",
      "embedding_dimension": 1024,
      "mode_predefined_enabled": true,
      "mode_vector_enabled": true,
      "mode_vector_index_path": "C:/Users/Алексей/Documents/WORK/Agent_v5/data/vector",
      "mode_vector_top_k": 5,
      "mode_vector_threshold": 0.75,
      "mode_vector_db_table": "oarb.audit_vectors",
      "mode_sql_enabled": true,
      "cli_default_mode": "predefined",
      "cli_default_format": "json",
      "cli_max_retries": 3,
      "cli_timeout_sec": 60,
      "vector_indexes": {
        "audits_index": {
          "table": "oarb.audits",
          "pk": "id",
          "source_table": "audits",
          "content_columns": [
            "title"
          ],
          "embedding_columns": [
            "title",
            "audit_type",
            "auditee_entity"
          ],
          "track_column": "updated_at",
          "enabled": true
        },
        "violations_index": {
          "table": "oarb.violations",
          "pk": "id",
          "source_table": "violations",
          "content_columns": [
            "violation_code",
            "description"
          ],
          "embedding_columns": [
            "violation_code",
            "description",
            "recommendation"
          ],
          "track_column": "created_at",
          "enabled": true
        },
        "audit_reports_index": {
          "table": "oarb.audit_reports",
          "pk": "id",
          "source_table": "audit_reports",
          "content_columns": [
            "title"
          ],
          "embedding_columns": [
            "title",
            "full_text"
          ],
          "track_column": "updated_at",
          "enabled": false
        },
        "report_items_index": {
          "table": "oarb.report_items",
          "pk": "id",
          "source_table": "report_items",
          "content_columns": [
            "item_title"
          ],
          "embedding_columns": [
            "item_title",
            "item_content"
          ],
          "track_column": "updated_at",
          "enabled": false
        }
      }
    }
  },
  "cli": {
    "show_reasoning": true,
    "show_tool_calls": true,
    "show_tool_results": true,
    "show_tool_params": true,
    "show_progress": true,
    "typewriter_speed": 0.01,
    "llm_timeout": 300,
    "exec_timeout": 60,
    "max_iterations": 200,
    "log_level": "WARNING"
  },
  "benchmark": {
    "db_schema": "public",
    "runs_table": "benchmark_runs",
    "results_table": "benchmark_results"
  },
  "streamlit": {
    "max_wait": 600,
    "poll_interval": 1.0
  },
  "gateway": {
    "storage": "auto",
    "persist_threshold": 5000,
    "persist_max_files": 100,
    "persist_max_age_hours": 0,
    "llm_timeout": 300,
    "exec_timeout": 60,
    "log_level": "INFO"
  }
}
