# Настройка Follow Up на этой машине. Скопируйте в follow_up.env.local
# (он под *.env.local в .gitignore) и подставьте свои пути; либо
# запустите scripts/install_into_nanobot.py из репозитория Follow Up —
# он заполнит файл сам.
FOLLOW_UP_ROOT=/opt/follow_up
FOLLOW_UP_PYTHON=/opt/follow_up/.venv/bin/python
MODELS_DEVICE=cpu
