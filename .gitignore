# ============================================================================
#  Корневой .gitignore для проекта nanobot
#  Дополняет workspace/.gitignore (только для data_store/.nanobot внутри workspace).
#  Защищает секреты, кеши, runtime-данные и артефакты удалённых навыков.
# ============================================================================

# --- Секреты (КРИТИЧНО: .secrets.env содержит API-ключи и DSN) ---
.secrets.env
.env
*.env.local

# --- Python: виртуальное окружение и кеши ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# --- pytest / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache

# --- Бенчмарки (только результаты прогонов, не сами тесты) ---
.benchmarks/

# --- Runtime-логи и история CLI ---
logs/
*.log
history/

# --- Артефакты удалённых навыков / legacy ---
webui/                       # старый SPA-dist (удалён в v1.3.0, см. CHANGELOG)
ws/                          # артефакты миграции data_store
media/                       # выгрузка из удалённого WebSocket-канала

# --- Runtime-данные workspace ---
# (workspace/.gitignore уже игнорирует data_store/cache/ и .nanobot/tool-results/ внутри workspace,
#  поэтому в корне только то, что не закрыто вложенным .gitignore)
workspace/sessions/           # JSONL-истории старого SessionManager

# --- DuckDB файлы (runtime-кеш) ---
*.duckdb
*.duckdb.wal
*.duckdb-shm
*.duckdb-journal

# --- Кеши реестров CLI-приложений (регенерируются) ---
cli-apps/*.json

# --- IDE/редакторы ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Разное ---
*.bak
*.tmp
*.pid
