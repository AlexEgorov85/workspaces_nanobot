# ============================================================================
#  Корневой .gitignore для проекта nanobot
#  Дополняет workspace/.gitignore (только для data_store/.nanobot внутри workspace).
#  Защищает секреты, кеши, runtime-данные и артефакты удалённых навыков.
# ============================================================================

# --- Секреты (КРИТИЧНО: .secrets.env содержит API-ключи и DSN) ---
.secrets.env
.env
*.env.local

# --- Python: виртуальное окружение и кеши ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# --- pytest / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache

# --- Бенчмарки (только результаты прогонов, не сами тесты) ---
.benchmarks/

# --- Runtime-логи и история CLI ---
/logs/
*.log
history/

# --- Артефакты удалённых навыков / legacy ---
# старый SPA-dist (удалён в v1.3.0, см. CHANGELOG)
webui/
# артефакты миграции data_store
ws/
# выгрузка из удалённого WebSocket-канала
media/

# --- Runtime-данные workspace ---
# (workspace/.gitignore уже игнорирует data_store/cache/ и .nanobot/tool-results/ внутри workspace,
#  поэтому в корне только то, что не закрыто вложенным .gitignore)
# JSONL-истории старого SessionManager
workspace/sessions/

# --- DuckDB файлы (runtime-кеш) ---
*.duckdb
*.duckdb.wal
*.duckdb-shm
*.duckdb-journal

# --- Кеши реестров CLI-приложений (регенерируются) ---
cli-apps/*.json

# --- IDE/редакторы ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Разное ---
*.bak
*.tmp
*.pid

# --- Локальный runtime ---
gw_pid.txt
workspace/config.json

# --- Агент-runtime: конфиг и память бота (не часть репозитория) ---
.opencode/
AGENTS.md
HEARTBEAT.md
SOUL.md
USER.md
memory/
prompts/
workspace/cron/
workspace/memory/.cursor

# --- Результаты бенчмарков (прогоны) ---
bench_full/
bench_full2/

# --- Runtime-данные вне workspace/.gitignore ---
data_store/
workspace/cache/
workspace/data_store/streamlit_files/
workspace/skills/audit_analyzer/data_store/

# --- Временные скрипты в кеше навыка ---
workspace/skills/audit_analyzer/cache/_*.py
