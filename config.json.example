{
  "agents": {
    "defaults": {
      "workspace": "~/.nanobot/workspace",
      "modelPreset": null,
      "model": "mistral-large-latest",
      "provider": "mistral",
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "contextBlockLimit": null,
      "temperature": 0.1,
      "fallbackModels": [],
      "maxToolIterations": 200,
      "maxConcurrentSubagents": 1,
      "maxToolResultChars": 16000,
      "providerRetryMode": "standard",
      "toolHintMaxLength": 40,
      "reasoningEffort": null,
      "timezone": "UTC",
      "botName": "Aura",
      "botIcon": "🐈",
      "unifiedSession": false,
      "disabledSkills": [],
      "idleCompactAfterMinutes": 0,
      "maxMessages": 120,
      "consolidationRatio": 0.5,
      "dream": {
        "intervalH": 2,
        "modelOverride": null,
        "maxBatchSize": 20,
        "maxIterations": 15,
        "annotateLineAges": true
      }
    }
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": false,
    "showReasoning": true,
    "sendMaxRetries": 3,
    "transcriptionProvider": "groq",
    "transcriptionLanguage": null,
    "postgres": {
      "enabled": true,
      "dsn": "postgresql://user:password@host:5432/dbname",
      "table": "conversation_messages",
      "schema": "public",
      "poll_interval": 2.0,
      "allow_from": ["*"]
    },
    "websocket": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8765,
      "path": "/",
      "token": "",
      "allowFrom": ["*"],
      "streaming": true,
      "maxMessageBytes": 37748736,
      "pingIntervalS": 20.0,
      "pingTimeoutS": 20.0
    }
  },
  "providers": {
    "groq": {
      "apiKey": "YOUR_GROQ_API_KEY",
      "apiBase": "https://api.groq.com/openai/v1"
    },
    "mistral": {
      "apiKey": "YOUR_MISTRAL_API_KEY",
      "apiBase": "https://api.mistral.ai/v1"
    },
    "ollama": {
      "apiKey": "ollama",
      "apiBase": "http://localhost:11434/v1"
    }
  },
  "tools": {
    "web": {
      "enable": true,
      "search": { "provider": "duckduckgo", "maxResults": 5 },
      "fetch": { "useJinaReader": true }
    },
    "exec": { "enable": true, "timeout": 60 },
    "my": { "enable": true, "allowSet": false },
    "restrictToWorkspace": false,
    "mcpServers": {},
    "ssrfWhitelist": [],
    "db_analyzer": {
      "database": {
        "connection_string": "postgresql://user:password@host:5432/dbname",
        "schema": "your_schema",
        "tables": ["table1", "table2"]
      },
      "embedding": {
        "base_url": "http://localhost:11434/api/embed",
        "model": "mxbai-embed-large:latest",
        "dimension": 1024
      },
      "modes": {
        "predefined": { "enabled": true },
        "vector": { "enabled": true, "index_path": "/path/to/vector/index", "top_k": 5, "threshold": 0.75 },
        "sql": { "enabled": true }
      }
    }
  }
}
